// Provider-wire compat for "opencode-go"; regenerated from the frozen census using deployment contract selectors.

provider "opencode-go" {
	default-model "kimi-k2.7-code"
	env "OPENCODE_API_KEY"
	dynamic-models-authoritative #true
	// Replaces the provider check that disabled forced tool choice on Responses.
	on-api "openai-responses" {
		supports-forced-tool-choice #false
		// The Go gateway proxies Muse Spark's Responses lane to Meta; warmed
		// siblings hit 2/2 sharing the family body key plus the
		// x-opencode-session header, vs 0/2 sharing only the body key under
		// distinct child session ids (2026-10-22, Spark 1.3 Contributor and
		// Spark 1.2 Contributor both measured the same 2/2-vs-0/2 pattern).
		// Same shared-prefix prompt_cache_key routing as native muse-code;
		// the opt-in lists exact verified ids only. The standard Spark 1.3
		// variant was never exactly lane-verified — only Contributor 1.3
		// and Contributor 1.2 measured the 2/2-vs-0/2 pattern — so it stays
		// off until verified, and the unmeasured standard Spark 1.2 id
		// likewise stays off.
		models "muse-spark-1.3-contributor" "muse-spark-1.2-contributor" {
			task-sibling-prompt-cache #true
		}
		// Re-probed 2026-10-25 with a cold / family-warm / different-family
		// control sequence: repeating the family key returned a warm read
		// (2791, 2789, 2816 and 3840 cached tokens on gpt-5.6-luna,
		// gpt-6-luna, grok-4.6 and grok-4.7) while the different-family
		// control sat at its own cold baseline (0, 0, 128 and 1152). The
		// spread isolates the family key, not either field that carries it:
		// on Responses both the body `prompt_cache_key` and
		// x-opencode-session repeat that key. Conversation ids, credentials,
		// and response state stay per-child.
		models "gpt-5.6-luna" "gpt-6-luna" "grok-4.6" "grok-4.7" {
			task-sibling-prompt-cache #true
		}
	}
	// Affinity-compatible sibling lanes verified outside Responses (2026-10-22
	// synthetic probe). Neither route accepts a prompt_cache_key body field:
	// Chat Completions gates it on a compat flag the Go gateway does not set,
	// and the Anthropic Messages wire has no such field, so on these lanes the
	// shared family key appears only in x-opencode-session while each
	// protocol's native cache body behavior is unchanged. All four lanes read
	// 2/2 warm with distinct actual child session ids; the body-key baselines
	// were also 2/2 on MiMo, DeepSeek and Haiku, and Kimi's 1/2 baseline ran
	// under a shared initial prefix that pre-warmed some legs —
	// affinity-compatibility evidence, not a comparative cache benefit.
	// Conversation ids, credentials, and response state stay per-child.
	//
	// Re-probed 2026-10-25 with a cold / family-warm / different-family
	// control sequence: these four ids returned a warm read only when the
	// family key repeated (warm vs control cached tokens: deepseek-v4-pro
	// 4608 vs 0, glm-5.1 2823 vs 10, glm-5.3-flash 4864 vs 0, omen-alpha
	// 4736 vs 0), so they join this lane's opt-in. Off: qwen3.6-plus and
	// gemini-4-argon showed no material warm hit (still unproven, not shown
	// broken), mimo-v2.5-pro is unavailable here (the upstream rejects it
	// with 400 Unsupported model), and the remaining cache-compatible Go
	// lanes warmed under any key, so a shared family key buys them nothing.
	on-api "openai-completions" {
		models "mimo-v2.6-flash" "kimi-k2.7-code" "deepseek-v4.1-flash" {
			task-sibling-prompt-cache #true
		}
		models "deepseek-v4-pro" "glm-5.1" "glm-5.3-flash" "omen-alpha" {
			task-sibling-prompt-cache #true
		}
	}
	on-api "anthropic-messages" {
		models "claude-haiku-5-5" {
			task-sibling-prompt-cache #true
		}
	}

	// The Flash lanes accept images despite their IDs lacking a vision suffix;
	// verified against the gateway (unguessable pixel-rendered text read back
	// verbatim). Mirrors the OpenRouter carve-out for deepseek-v4.1-flash.
	// The modality is declared here as well: live gateway discovery seeds
	// `input: ["text"]`, and the wire guard requires the declared modality, so
	// clearing `strip-image-input` alone would leave the lane text-only.
	models "deepseek-flash" "deepseek-v4.1-flash" {
		input-modalities "text" "image"
		strip-image-input #false
	}
	// residue: the ids-only Go roster lists this bare V4.1 Flash alias with no
	// price, limits or reasoning flag, and neither models.dev nor the bundle has
	// a row to hydrate it from (#15357). Mirror the gateway's own
	// `deepseek-v4.1-flash` row; `cost-fallback` yields to any price discovery
	// reports later.
	models "deepseek-flash" {
		thinking-upgrade-neutral #true
		cost-fallback {
			input 0.15
			output 0.6
			cache-read 0.003
			cache-write 0.0
		}
		limits-patch {
			context-window 1000000
			max-tokens 384000
		}
	}
	// Live Go discovery lists Argon without capabilities; its native Gemini
	// endpoint requires a thinking level and accepts LOW, MEDIUM, or HIGH.
	models "gemini-4-argon-contributor" {
		thinking-upgrade-neutral #true
		thinking-mode "google-level"
		thinking-efforts "low" "medium" "high"
		thinking-requires-effort #true
		input-modalities "text" "image"
		limits-patch {
			context-window 1048576
			max-tokens 65536
		}
	}
	// Replaces the OpenCode reasoning-model whenThinking fallback object.
	when-thinking {
		requires-reasoning-content-for-tool-calls #true
		allows-synthetic-reasoning-content-for-tool-calls #false
		reasoning-content-field "reasoning_content"
	}
	// The gateway's usage-limit error means a provider-wide quota window; when it
	// exceeds the retry cap, recovery may route to a different provider.
	long-usage-limit-fallback #true
	class "deepseek" {
		thinking-mode "effort"
		family "flash" {
			supports-tool-choice #false
		}
	}
	// residue: the vision-exp lane keeps tool choice available.
	models "deepseek-v4-flash-vision-exp" {
		supports-tool-choice #true
	}
	// residue: the gateway's DeepSeek V4 flash/pro lanes reject tool_choice,
	// speak max_tokens + reasoning_content, and require reasoning replay on
	// tool calls (both the completions and responses routes).
	models "deepseek-v4-flash" "deepseek-v4-pro" {
		supports-tool-choice #false
		max-tokens-field "max_tokens"
		reasoning-content-field "reasoning_content"
		requires-reasoning-content-for-tool-calls #true
	}
	class "glm" {
		thinking-mode "effort"
	}
	class "kimi" {
		thinking-mode "effort"
	}
	// The Go gateway proxies Muse Spark's Responses lane to Meta but cannot
	// round-trip encrypted reasoning: the upstream issues `encrypted_content`
	// bound to the gateway's own caller, so replaying it on a later step 400s
	// with "reasoning `encrypted_content` was not issued to this caller"
	// (#11928). Stop requesting it and drop native reasoning items from replay
	// so multi-step tool-call turns stop failing.
	class "meta" {
		family "muse-spark" {
			include-encrypted-reasoning #false
			filter-reasoning-history #true
		}
	}
	class "mimo" {
		family "v2" {
			thinking-mode "effort"
		}
		// The gateway rejects tool_choice for every MiMo lane.
		supports-tool-choice #false
	}
	class "qwen" {
		revision ">=3.5 <3.7" {
			thinking-efforts "minimal" "low" "medium" "high"
			thinking-mode "effort"
		}
		revision ">=3.7 <3.9" {
			thinking-efforts "minimal" "low" "medium" "high" 
			thinking-mode "effort"
		}
	}
	// Step 5 Preview uses low/medium/high on this gateway (#14987).
	class "stepfun" {
		family "step" {
			thinking-mode "effort"
			thinking-efforts "low" "medium" "high"
		}
	}
	// LongCat exposes a reasoning toggle, not selectable effort tiers.
	// Off uses the gateway's boolean reasoning switch, never a fake lowest tier.
	models "longcat-2.5-preview-free" {
		thinking-efforts
		supports-reasoning-effort #false
		reasoning-disable-mode "openrouter-enabled-false"
	}
	// Space Bunny publishes low through max, without the generic minimal tier.
	models "space-bunny-free" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "glm-5" "glm-5.1" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// residue: the Ox Alpha stealth SKU reasons through the wire-exact
	// low/high/max ladder with mandatory thinking (issue #9349).
	models "ox-alpha*" {
		thinking-efforts "low" "high" "max"
		thinking-requires-effort #true
	}
	// residue: the 3.8 Flash lane keeps the budget dialect with the xhigh tier.
	models "qwen3.8-flash" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "budget"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "glm-5.2" {
		thinking-efforts "minimal" "low" "medium" "high" "max"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.6-luna" "grok-4.5" "minimax-m2.7" "minimax-m3" {
		thinking-mode "effort"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "hy3" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "kimi-k2.7-code" {
		supports-forced-tool-choice #false
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "minimax-m2.5" {
		// Replaces the Anthropic-route MiniMax effort remap table.
		thinking-effort-map {
			low "adaptive"
			medium "adaptive"
			high "adaptive"
		}
		thinking-mode "anthropic-adaptive"
	}
}
